# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dirly

# JWT signing secret (required in production)
JWT_SECRET=dirly-dev-secret-change-me

# API port
PORT=4000

# Allowed web origin
CORS_ORIGIN=http://localhost:5173

# Optional MQTT bridge. Empty disables the MQTT client (HTTP ingest still works).
MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC=soil/sensors/+/data
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Optional shared secret for device ingest (POST /api/readings).
# Empty allows unauthenticated ingest in development. Set it in production.
DEVICE_TOKEN=

# Values used by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@dirly.dev
SEED_ADMIN_PASSWORD=admin123

NODE_ENV=development