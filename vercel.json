{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build -w @dirly/web",
      "outputDirectory": "apps/web/dist"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }]
}